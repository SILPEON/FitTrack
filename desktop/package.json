{
  "name": "fittrack-desktop",
  "productName": "FitTrack",
  "version": "1.0.0",
  "description": "FitTrack for Windows",
  "author": "FitTrack",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "copy-web": "node -e \"require('fs').rmSync('app',{recursive:true,force:true});require('fs').cpSync('../dist','app',{recursive:true})\"",
    "start": "npm run copy-web && electron .",
    "dist": "npm run copy-web && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.0.20"
  },
  "build": {
    "appId": "io.github.silpeon.fittrack",
    "productName": "FitTrack",
    "files": ["main.cjs", "app/**/*"],
    "icon": "icon.png",
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "FitTrack-Setup-${version}.exe"
    },
    "portable": { "artifactName": "FitTrack-Portable-${version}.exe" }
  }
}
